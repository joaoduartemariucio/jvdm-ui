{
  "name": "jvdm-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo do jvdm-ui: um design system, uma fonte de tokens, uma implementação por plataforma.",
  "license": "MIT",
  "author": "João Vitor Duarte Mariucio",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @jvdm-ui/tokens && npm run build -w jvdm-ui",
    "dev": "npm run dev -w jvdm-ui",
    "typecheck": "tsc --noEmit && npm run typecheck -w @jvdm-ui/react-native",
    "test": "npm run test -w @jvdm-ui/tokens && npm run test -w jvdm-ui && npm run test -w @jvdm-ui/react-native && npm run test:scripts && npm run parity && npm run scales",
    "test:coverage": "npm run test -w @jvdm-ui/tokens && npm run test:coverage -w jvdm-ui && npm run test -w @jvdm-ui/react-native && npm run test:scripts && npm run parity && npm run scales",
    "tokens": "npm run emit -w @jvdm-ui/tokens",
    "contracts": "node scripts/extract-contract.mjs",
    "parity": "node scripts/check-parity.mjs",
    "scales": "node scripts/check-scales.mjs",
    "test:ios": "swift test",
    "test:flutter": "cd packages/flutter && flutter test",
    "test:android": "cd packages/android && ./gradlew test ktlintCheck assembleRelease",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "typecheck:site": "tsc --noEmit -p site/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.84.1",
    "react-native-svg": "^15.16.0",
    "react-test-renderer": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaoduartemariucio/jvdm-ui.git"
  },
  "homepage": "https://joaoduartemariucio.github.io/jvdm-ui",
  "bugs": {
    "url": "https://github.com/joaoduartemariucio/jvdm-ui/issues"
  }
}
