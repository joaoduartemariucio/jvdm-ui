{
  "name": "jvdm-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo do jvdm-ui: um design system, uma fonte de tokens, uma implementação por plataforma.",
  "license": "MIT",
  "author": "João Vitor Duarte Mariucio",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w jvdm-ui",
    "dev": "npm run dev -w jvdm-ui",
    "typecheck": "tsc --noEmit",
    "test": "npm run test -w jvdm-ui",
    "test:coverage": "npm run test:coverage -w jvdm-ui",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "typecheck:site": "tsc --noEmit -p site/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaoduartemariucio/jvdm-ui.git"
  },
  "homepage": "https://joaoduartemariucio.github.io/jvdm-ui",
  "bugs": {
    "url": "https://github.com/joaoduartemariucio/jvdm-ui/issues"
  }
}
