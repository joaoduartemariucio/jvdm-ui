{
  "name": "jvdm-ui",
  "version": "0.2.1",
  "description": "Design system em React 19 + Tailwind v4: tokens em oklch, tema claro/escuro e componentes em quatro camadas.",
  "license": "MIT",
  "author": "João Vitor Duarte Mariucio",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client/*": {
      "types": "./dist/client/*.d.ts",
      "import": "./dist/client/*.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms/index.js"
    },
    "./molecules": {
      "types": "./dist/molecules/index.d.ts",
      "import": "./dist/molecules/index.js"
    },
    "./organisms": {
      "types": "./dist/organisms/index.d.ts",
      "import": "./dist/organisms/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./presets/gavel.css": "./dist/presets/gavel.css"
  },
  "scripts": {
    "build": "tsup && node scripts/build-presets.mjs && cp src/tokens/tokens.css dist/tokens.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "typecheck:site": "tsc --noEmit -p site/tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  },
  "bin": {
    "jvdm-ui": "./bin/jvdm-ui.mjs"
  },
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "ui",
    "components",
    "theming",
    "design-tokens",
    "oklch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaoduartemariucio/jvdm-ui.git"
  },
  "homepage": "https://joaoduartemariucio.github.io/jvdm-ui",
  "bugs": {
    "url": "https://github.com/joaoduartemariucio/jvdm-ui/issues"
  }
}
