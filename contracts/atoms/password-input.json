{
  "name": "PasswordInput",
  "contract": "password-input",
  "layer": "atoms",
  "source": "atoms/input/password-input/index.tsx",
  "host": {
    "element": "input",
    "omits": [
      "size",
      "type"
    ]
  },
  "props": [
    {
      "name": "size",
      "optional": true,
      "type": "ControlSize",
      "values": [
        "sm",
        "md"
      ]
    },
    {
      "name": "showLabel",
      "optional": true,
      "type": "string",
      "default": "locales.show",
      "defaultKind": "expression"
    },
    {
      "name": "hideLabel",
      "optional": true,
      "type": "string",
      "default": "locales.hide",
      "defaultKind": "expression"
    },
    {
      "name": "className",
      "optional": true,
      "type": "unknown",
      "inherited": true,
      "affordance": "styling",
      "default": "",
      "defaultKind": "literal"
    }
  ],
  "locales": [
    {
      "key": "show"
    },
    {
      "key": "hide"
    }
  ]
}
