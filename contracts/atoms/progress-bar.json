    },
    {
      "name": "dim",
      "optional": true,
      "type": "boolean",
      "default": "false",
      "defaultKind": "literal"
    },
    {
      "name": "label",
      "optional": true,
      "type": "string"
    },
    {
      "name": "className",
      "optional": true,
      "type": "string",
      "default": "",
      "defaultKind": "literal"
    }
  ],
  "locales": []
}
