{
  "name": "jvdm-ui",
  "version": "1.2.0",
  "description": "Design system em React 19 + Tailwind v4: tokens em oklch, tema claro/escuro e componentes em quatro camadas.",
  "license": "MIT",
  "author": "João Vitor Duarte Mariucio",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client/*": {
      "types": "./dist/client/*.d.ts",
      "import": "./dist/client/*.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms/index.js"
    },
    "./molecules": {
      "types": "./dist/molecules/index.d.ts",
      "import": "./dist/molecules/index.js"
    },
    "./organisms": {
      "types": "./dist/organisms/index.d.ts",
      "import": "./dist/organisms/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./presets/gavel.css": "./dist/presets/gavel.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/build-presets.mjs && cp src/tokens/tokens.css dist/tokens.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run && node --test tests/theme.test.mjs",
    "test:coverage": "npm run build && vitest run --coverage && node --test tests/theme.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "bin": {
    "jvdm-ui": "./bin/jvdm-ui.mjs"
  },
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "ui",
    "components",
    "theming",
    "design-tokens",
    "oklch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaoduartemariucio/jvdm-ui.git",
    "directory": "packages/web"
  },
  "homepage": "https://joaoduartemariucio.github.io/jvdm-ui",
  "bugs": {
    "url": "https://github.com/joaoduartemariucio/jvdm-ui/issues"
  }
}
